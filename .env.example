# Copy this file to .env and fill in real values. .env is never committed / read by anyone but this bot.

# Not used by the current direct-analysis workflow (Claude Code itself does the
# analysis, no API calls) -- only needed if you ever revert to _archive_old_api_bot/.
# From https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# From @BotFather on Telegram (create a bot, it gives you a token like 123456789:AAxxxxx...)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your own numeric Telegram user ID (NOT username) -- the bot ignores everyone else.
# Get it by messaging @userinfobot on Telegram.
TELEGRAM_ALLOWED_USER_ID=your_numeric_telegram_user_id_here

# Optional -- default position-sizing risk amount in USD, used whenever a command needs
# one and doesn't specify inline. Can also be set/changed later via the /setrisk command.
DEFAULT_RISK_USD=

# Optional -- item 8, Hardening Pass (circuit breaker). Number of CONSECUTIVE real
# stop-outs (fully-closed positions whose final exit was a stop, not a target/manual
# exit) after which every screener/monitor report carries a standing warning until a
# non-stop close resets the streak. Warning only, never a block -- the human decides.
# Unset or non-numeric = breaker inactive; there is no built-in default (never invent
# a limit you didn't set). Suggested value: 3.
CIRCUIT_BREAKER_STOPOUTS=
